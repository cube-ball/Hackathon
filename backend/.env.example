# Copy this file to backend/.env and fill it in. NEVER commit backend/.env.
# Variables already set in your terminal (e.g. OPENROUTER_API_KEY in ~/.zshrc) take priority.

OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_MODEL=~anthropic/claude-haiku-latest

# Stripe TEST mode only (dashboard.stripe.com -> Developers -> API keys, with "Test mode" on)
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by: stripe listen --forward-to localhost:5050/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where Stripe sends the student back to after paying (the Streamlit app)
APP_URL=http://localhost:8501
